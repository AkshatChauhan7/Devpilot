# DevPilot Environment Configuration

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+asyncpg://devpilot:devpilot@localhost:5432/devpilot
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot
POSTGRES_DB=devpilot

# Redis
REDIS_URL=redis://localhost:6379/0

# GitHub App
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub OAuth (for user authentication)
GITHUB_OAUTH_CLIENT_ID=your-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-fable-5-2

# Execution Environment
DOCKER_HOST=unix:///var/run/docker.sock
EXECUTION_TIMEOUT=300
MAX_CONCURRENT_EXECUTIONS=5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001